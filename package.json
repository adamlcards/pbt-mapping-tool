{
  "name": "pbt-mapping-tool",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Map process-based networks, find the feedback loops, and test what would break them.",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "standalone": "node build-standalone.mjs ../PBT-Mapping-Tool.html",
    "i18n:extract": "node scripts/extract-strings.mjs",
    "i18n:check": "node scripts/check-locales.mjs",
    "i18n:review": "node scripts/export-review.mjs && python3 scripts/make_review_docs.py",
    "i18n:merge": "python3 scripts/merge_review_docs.py"
  },
  "dependencies": {
    "cytoscape": "^3.30.2",
    "cytoscape-dagre": "^4.0.0",
    "dagre": "^0.8.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/cytoscape": "^3.21.6",
    "@types/dagre": "^0.7.54",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "jsdom": "^30.0.1",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^2.1.4",
    "wrangler": "^4.118.0"
  }
}
